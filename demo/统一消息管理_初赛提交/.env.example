# 复制成 .env 后填写，不要提交到仓库

# mock = 模拟模式，不需要任何平台凭证
# real = 真实模式，下面凭证必须填全
UMM_MODE=mock

# 飞书自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# 群自定义机器人 Webhook，形如 https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# 填了之后发送方向走它，不需要上面三个值
FEISHU_WEBHOOK_URL=

# 钉钉企业内部应用
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=
# 群自定义机器人 Webhook，形如 https://oapi.dingtalk.com/robot/send?access_token=xxxx
# 填了之后发送方向走它，不需要上面三个值
DINGTALK_WEBHOOK_URL=
# 安全设置勾了「加签」时填这串（SEC 开头、67 位）；选「自定义关键词」或「IP 地址段」就不用填
DINGTALK_WEBHOOK_SECRET=
# 单聊回复的收件人 userId，从企业内部应用通讯录取（如 0235xxxxxxxxxxxx）。
# 填了之后网页上的「回复」会以机器人单聊形式发回给这个人，手机上直接收到。
# 别填回调里的 senderId——那个是加密串（$:LWCP_v1:$...），发送时会报无效人员
DINGTALK_DEFAULT_USER_ID=

# 是否启用钉钉长连接（Stream 模式）接收真实消息。1=启用，0=关闭（默认关）
# 启用前要填上面的 DINGTALK_APP_KEY / DINGTALK_APP_SECRET，
# 并且执行 pip install dingtalk-stream；不启用的话不装这个包也没关系
UMM_DINGTALK_STREAM=0

# 统一入口登录账号（演示用，生产应换成数据库校验）
UMM_USER=demo
UMM_PASSWORD=demo1234

# 会话签名密钥。多实例部署必须固定，否则各副本密钥不同，用户会被反复踢下线
UMM_SECRET_KEY=
